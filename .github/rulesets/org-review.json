{
  "name": "org-review",
  "target": "branch",
  "enforcement": "evaluate",
  "bypass_actors": [],
  "conditions": {
    "repository_property": {
      "include": [
        { "name": "org-review", "property_values": ["true"], "source": "custom" }
      ],
      "exclude": []
    },
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
