  },
  "rules": [
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": false,
        "workflows": [
          {
            "path": ".github/workflows/org-review.yml",
            "repository_id": 1393972009,
            "ref": "refs/heads/main"
          }
        ]
      }
    }
  ]
}
